      "html": "<div class=\"ds-pills\"><span class=\"ds-pill ds-pill-ok\"><svg width=\"9\" height=\"9\" viewBox=\"0 0 10 10\" aria-hidden=\"true\"><circle cx=\"5\" cy=\"5\" r=\"4\" fill=\"currentColor\"/></svg>Connected</span><span class=\"ds-pill ds-pill-danger\">3 faults</span><span class=\"ds-pill ds-pill-neutral\">Could not read</span></div>",
      "css": ".ds-pills{display:flex;gap:8px;flex-wrap:wrap;font-family:-apple-system, 'SF Pro Text', system-ui, sans-serif}.ds-pill{display:inline-flex;align-items:center;gap:4px;border-radius:999px;padding:3px 9px;font-size:13px;font-weight:600;letter-spacing:-0.08px;font-variant-numeric:tabular-nums}.ds-pill-ok{background:rgba(48,209,88,0.18);color:#30D158}.ds-pill-danger{background:rgba(255,69,58,0.2);color:#FF6961}.ds-pill-neutral{background:#2C2C2E;color:rgba(235,235,245,0.64)}"
