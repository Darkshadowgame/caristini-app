      "description": "Inset grouped section: uppercase header outside, rows with one colour square per tool, tabular trailing values and chevrons.",
      "html": "<div class=\"ds-group\"><div class=\"ds-group-header\">Tools</div><div class=\"ds-group-body\"><button class=\"ds-row\"><span class=\"ds-row-icon\" style=\"background:#FF453A\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h4l2-5 4 10 2-5h4\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"ds-row-main\"><span class=\"ds-row-title\">Diagnose</span><span class=\"ds-row-value\">8 faults</span><span class=\"ds-row-chev\"><svg width=\"8\" height=\"13\" viewBox=\"0 0 8 13\" aria-hidden=\"true\"><path d=\"M1.5 1.5l5 5-5 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></button><button class=\"ds-row\"><span class=\"ds-row-icon\" style=\"background:#0A84FF\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 17l5-6 4 3 5-7 4 4\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"ds-row-main\"><span class=\"ds-row-title\">Live data</span><span class=\"ds-row-value\">31 values</span><span class=\"ds-row-chev\"><svg width=\"8\" height=\"13\" viewBox=\"0 0 8 13\" aria-hidden=\"true\"><path d=\"M1.5 1.5l5 5-5 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></button><button class=\"ds-row\"><span class=\"ds-row-icon\" style=\"background:#30D158\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14 6a4 4 0 0 1-5 5L4 16l4 4 5-5a4 4 0 0 0 5-5l-2 2-2-2z\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"ds-row-main\"><span class=\"ds-row-title\">Service reset</span><span class=\"ds-row-value\">2 guides</span><span class=\"ds-row-chev\"><svg width=\"8\" height=\"13\" viewBox=\"0 0 8 13\" aria-hidden=\"true\"><path d=\"M1.5 1.5l5 5-5 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></button><button class=\"ds-row\"><span class=\"ds-row-icon\" style=\"background:#5E5CE6\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 7h10v10H7zM10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"ds-row-main\"><span class=\"ds-row-title\">ECU info</span><span class=\"ds-row-value\">33 modules</span><span class=\"ds-row-chev\"><svg width=\"8\" height=\"13\" viewBox=\"0 0 8 13\" aria-hidden=\"true\"><path d=\"M1.5 1.5l5 5-5 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></button><button class=\"ds-row\"><span class=\"ds-row-icon\" style=\"background:#BF5AF2\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h10M18 7h2M4 17h4M12 17h8M14 5v4M8 15v4\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"ds-row-main\"><span class=\"ds-row-title\">Customise</span><span class=\"ds-row-value\">5 options</span><span class=\"ds-row-chev\"><svg width=\"8\" height=\"13\" viewBox=\"0 0 8 13\" aria-hidden=\"true\"><path d=\"M1.5 1.5l5 5-5 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></button><button class=\"ds-row\"><span class=\"ds-row-icon\" style=\"background:#40C8E0\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M10 4a6 6 0 1 1 0 12 6 6 0 0 1 0-12zM15 15l5 5\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"ds-row-main\"><span class=\"ds-row-title\">Code lookup</span><span class=\"ds-row-value\">345 codes</span><span class=\"ds-row-chev\"><svg width=\"8\" height=\"13\" viewBox=\"0 0 8 13\" aria-hidden=\"true\"><path d=\"M1.5 1.5l5 5-5 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></button></div></div>",
      "css": ".ds-group{width:100%;max-width:390px;font-family:-apple-system, 'SF Pro Text', system-ui, sans-serif}.ds-group-header{font-size:13px;line-height:18px;letter-spacing:-0.08px;text-transform:uppercase;color:rgba(235,235,245,0.64);margin:0 0 6px 16px}.ds-group-body{background:#1C1C1E;border-radius:16px;overflow:hidden}.ds-row{display:flex;align-items:center;width:100%;min-height:50px;padding:0 0 0 16px;border:none;background:transparent;color:#FFFFFF;cursor:pointer;text-align:left;font:inherit}.ds-row:hover,.ds-row:active{background:#2C2C2E}.ds-row:focus-visible{outline:2px solid #FFB340;outline-offset:-2px}.ds-row-icon{width:30px;height:30px;border-radius:7px;display:flex;align-items:center;justify-content:center;margin-right:12px;flex:none}.ds-row-main{flex:1;display:flex;align-items:center;gap:8px;align-self:stretch;min-height:50px;padding-right:16px;border-top:0.5px solid rgba(84,84,88,0.6)}.ds-row:first-child .ds-row-main{border-top:none}.ds-row-title{flex:1;font-size:17px;line-height:22px;letter-spacing:-0.41px}.ds-row-value{font-size:17px;letter-spacing:-0.41px;color:rgba(235,235,245,0.64);font-variant-numeric:tabular-nums}.ds-row-chev{color:rgba(235,235,245,0.32);display:flex}"
