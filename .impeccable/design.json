      "html": "<button class=\"ds-btn-secondary\">Scan again</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:50px;padding:0 24px;border:none;border-radius:25px;font-family:-apple-system, 'SF Pro Text', system-ui, sans-serif;font-size:17px;font-weight:600;letter-spacing:-0.41px;cursor:pointer;transition:transform 0.12s ease-out, opacity 0.12s ease-out;background:rgba(255,179,64,0.18);color:#FFB340;width:100%}.ds-btn-secondary:hover{opacity:0.9}.ds-btn-secondary:active{opacity:0.75;transform:scale(0.97)}.ds-btn-secondary:focus-visible{outline:2px solid #FFB340;outline-offset:3px}.ds-btn-secondary:disabled{opacity:0.4;cursor:default}"
    },
    {
