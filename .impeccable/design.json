  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action on a screen: amber capsule with a near-black label and leading glyph.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 20s-7-4.4-9-9a4.8 4.8 0 0 1 9-3 4.8 4.8 0 0 1 9 3c-2 4.6-9 9-9 9z\" fill=\"currentColor\"/></svg>Run health check</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:50px;padding:0 24px;border:none;border-radius:25px;font-family:-apple-system, 'SF Pro Text', system-ui, sans-serif;font-size:17px;font-weight:600;letter-spacing:-0.41px;cursor:pointer;transition:transform 0.12s ease-out, opacity 0.12s ease-out;background:#FFB340;color:#1A1205;width:100%}.ds-btn-primary:hover{opacity:0.9}.ds-btn-primary:active{opacity:0.75;transform:scale(0.97)}.ds-btn-primary:focus-visible{outline:2px solid #FFB340;outline-offset:3px}.ds-btn-primary:disabled{opacity:0.4;cursor:default}"
    },
