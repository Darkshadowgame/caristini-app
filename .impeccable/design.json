      "kind": "button",
      "refersTo": "button-danger",
      "description": "Writes to the car, always behind the Confirm Sheet: red wash with red text.",
      "html": "<button class=\"ds-btn-danger\">Clear all faults</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:50px;padding:0 24px;border:none;border-radius:25px;font-family:-apple-system, 'SF Pro Text', system-ui, sans-serif;font-size:17px;font-weight:600;letter-spacing:-0.41px;cursor:pointer;transition:transform 0.12s ease-out, opacity 0.12s ease-out;background:rgba(255,69,58,0.2);color:#FF6961;width:100%}.ds-btn-danger:hover{opacity:0.9}.ds-btn-danger:active{opacity:0.75;transform:scale(0.97)}.ds-btn-danger:focus-visible{outline:2px solid #FFB340;outline-offset:3px}.ds-btn-danger:disabled{opacity:0.4;cursor:default}"
