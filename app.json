{
  "expo": {
    "name": "Caristini",
    "slug": "caristini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.philmuspratt.caristini"
    },
    "android": {
      "package": "com.philmuspratt.caristini",
      "adaptiveIcon": {
        "backgroundColor": "#16213A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Caristini uses Bluetooth to talk to your OBD2 adapter."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1020"
          }
        }
      ]
    ],
    "scheme": "caristini",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7c719cd9-f7ca-4c11-80e1-c8ab557d96f9",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "eas": {
        "projectId": "7c719cd9-f7ca-4c11-80e1-c8ab557d96f9"
      }
    }
  }
}
