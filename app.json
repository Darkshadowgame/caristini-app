{
  "expo": {
    "name": "Pin16",
    "slug": "caristini",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.philmuspratt.caristini"
    },
    "android": {
      "package": "com.philmuspratt.caristini",
      "adaptiveIcon": {
        "backgroundColor": "#131316",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Pin16 uses Bluetooth to talk to your OBD2 adapter."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pin16 uses your location only while the data logger or a long read such as Learn my car is running. It keeps the read going when you switch apps or lock the phone, and saves the route with data logs. Your location stays on this phone.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#131316",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#131316"
          }
        }
      ]
    ],
    "scheme": "caristini",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7c719cd9-f7ca-4c11-80e1-c8ab557d96f9",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "eas": {
        "projectId": "7c719cd9-f7ca-4c11-80e1-c8ab557d96f9"
      }
    }
  }
}
